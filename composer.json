{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "funseco/scoreboard-plugin",
    "description": "Funseco score screen lists, toplist widget and windows, /estat",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "funseco/core": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Funseco\\Scoreboard\\": "src/"
        }
    },
    "require-dev": {
        "funseco/karma-plugin": "@dev",
        "funseco/rankings-plugin": "@dev",
        "funseco/records-plugin": "@dev",
        "funseco/widgets-plugin": "@dev",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Funseco\\Scoreboard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "funseco": {
            "id": "scoreboard",
            "name": "Scoreboard",
            "description": "score screen lists, toplist widget and windows, /estat",
            "provider": "Funseco\\Scoreboard\\ScoreboardServiceProvider"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
